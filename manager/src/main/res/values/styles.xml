<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Light" />

    <style name="TitleTextAppearance.Xiluoya" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="SubtitleTextAppearance.Xiluoya" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
    </style>

    <style name="XiluoyaNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?colorPrimaryContainer</item>
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
    </style>

    <style name="Card">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="Card.Light" />

    <style name="CardButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="iconPadding">12dp</item>
        <!-- Xiluoya: 收窄圆角，脱离 Shizuku 的 pill 形 -->
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textAppearance">?textAppearanceBodyLarge</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">1sp</item>
    </style>

    <style name="CardSummary">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">?android:textColorSecondary</item>
        <item name="android:layout_marginTop">4sp</item>
    </style>

    <style name="CardContent">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>

    <style name="CardIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_rounded_square_icon</item>
        <item name="android:tint">?colorOnPrimaryContainer</item>
        <item name="android:tintMode">src_in</item>
        <item name="android:backgroundTint">?colorPrimaryContainer</item>
        <item name="android:backgroundTintMode">src_in</item>
    </style>

    <style name="GrantPermissions" parent="@style/AppTheme">
        <item name="android:colorBackground">?colorBackgroundFloating</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="TerminalTutorialText">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FilledCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-4dp</item>
        <item name="android:layout_marginEnd">-4dp</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="contentPaddingStart">24dp</item>
        <item name="contentPaddingEnd">24dp</item>
        <item name="contentPaddingLeft">24dp</item>
        <item name="contentPaddingRight">24dp</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
        <item name="cardBackgroundColor">?colorSecondaryContainer</item>
    </style>

    <style name="GrantPermissionsButtons">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?textColorOnPrimaryContainer</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GrantPermissionsButtons.Top">
        <item name="android:background">@drawable/grant_permissions_buttons_top</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="GrantPermissionsButtons.Buttom">
        <item name="android:background">@drawable/grant_permissions_buttons_bottom</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>


    <style name="TextAppearance.Xiluoya.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/misans</item>
    </style>
    <style name="TextAppearance.Xiluoya.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/misans</item>
    </style>

    <style name="XiluoyaPreference" parent="Preference">
        <item name="android:background">@drawable/bg_preference_item</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="XiluoyaPreference.Category" parent="Preference.Category">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">?colorPrimary</item>
    </style>

    <style name="XiluoyaPreference.Switch" parent="Preference.SwitchPreferenceCompat">
        <item name="android:background">@drawable/bg_preference_item</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="XiluoyaPreference.List" parent="Preference.DropDown">
        <item name="android:background">@drawable/bg_preference_item</item>
        <item name="iconSpaceReserved">false</item>
    </style>


    <style name="PreferenceThemeOverlay.Xiluoya" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/XiluoyaPreference</item>
        <item name="preferenceCategoryStyle">@style/XiluoyaPreference.Category</item>
    </style>

</resources>
