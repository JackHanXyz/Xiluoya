<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="112dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="@dimen/content_top_padding"
        android:paddingEnd="16dp">

        <!-- 应用身份区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_display_name"
                android:textColor="?android:textColorPrimary"
                android:textSize="22sp"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 说明卡 -->
        <com.google.android.material.card.MaterialCardView
            style="?materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?colorSurfaceContainerHigh"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_tech_title"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="15sp"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/tech_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 链接 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_source"
            style="@style/CardButton"
            android:layout_marginTop="16dp"
            android:text="@string/about_view_source"
            app:icon="@drawable/ic_open_in_new_24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_licenses"
            style="@style/CardButton"
            android:layout_marginTop="8dp"
            android:text="@string/about_licenses"
            app:icon="@drawable/ic_code_24dp" />

    </LinearLayout>
</ScrollView>
